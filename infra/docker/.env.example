# MTMS Local Development Environment Variables Example
# Copy this file to .env in this directory (infra/docker/.env) before running docker compose.
# NEVER commit the real .env to source control.

# PostgreSQL 17 configuration (POSTGRES_PASSWORD is mandatory, no default in compose)
POSTGRES_DB=mtms
POSTGRES_USER=mtms_user
POSTGRES_PASSWORD=replace_with_a_secure_password
POSTGRES_PORT=5432

# Application service ports
BACKEND_PORT=8080
FRONTEND_PORT=80

