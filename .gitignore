# ========================================================
# MTMS - Comprehensive .gitignore
# ========================================================

# Environment, credentials & secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env.*.example
**/secrets/
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDEs & Editors
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# AI Agent runtimes, sessions & local state
# (Keep agent definition files tracked)
.taste-skill/
.codex/*
!.codex/agents/
.codex/agents/*
!.codex/agents/*.toml
.herdr/
*.sock
*.session
agent_workspace/tmp/
agent_workspace/scratch/

# Java / Spring Boot / Maven / Gradle
**/target/
**/build/
**/.gradle/
*.class
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
**/.mvn/timing.properties
!**/src/main/**
!**/src/test/**

# Frontend / Node / React / TypeScript
**/node_modules/
**/dist/
**/.vite/
**/coverage/
**/.next/
**/.nuxt/
**/.turbo/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python (tools & validators)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
ENV/

# Database, Runtime data, uploads & dumps
*.sqlite
*.sqlite3
*.db
*.dump
*.bak
*.backup
*.log
**/logs/
**/uploads/
**/backups/
**/tmp/
**/temp/
**/runtime-data/

# Keep baseline documentation and templates under version control
